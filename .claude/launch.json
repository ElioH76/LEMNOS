{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lemnos-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "lemnos-dev-3100",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "lemnos-dev-noblob",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": { "BLOB_READ_WRITE_TOKEN": "" },
      "port": 3000
    },
    {
      "name": "lemnos-prod-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "env": { "BLOB_READ_WRITE_TOKEN": "" },
      "port": 3000
    }
  ]
}
