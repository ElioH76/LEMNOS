# Copier en .env.local pour le dev, et renseigner ces variables sur Vercel
# (Project Settings → Environment Variables) pour la production.

# Mot de passe de l'espace admin (/admin) — OBLIGATOIRE pour y accéder.
ADMIN_PASSWORD=

# Base Postgres (Vercel Postgres / Neon).
# Fournie automatiquement par l'intégration Vercel Storage (onglet Storage).
# Variantes acceptées, dans l'ordre : DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL.
# Sans base, les demandes sont conservées en mémoire (perdues au redéploiement).
DATABASE_URL=

# Stockage de fichiers (Vercel Blob) — pour les logos clients et, à venir, les
# designs et la médiathèque. Fourni automatiquement par l'intégration Vercel
# Storage (onglet Storage → Create → Blob). Sans jeton, l'UI retombe sur une
# saisie d'URL manuelle (aucun upload).
BLOB_READ_WRITE_TOKEN=
